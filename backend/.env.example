# МЭШ Колледж - Переменные окружения
# Скопируй в .env и заполни свои значения

# Секретный ключ для JWT (измени в продакшене!)
SECRET_KEY=your-super-secret-key-here

# МосАйДи OAuth
MOSAIDI_CLIENT_ID=your-client-id
MOSAIDI_CLIENT_SECRET=your-client-secret
MOSAIDI_REDIRECT_URI=http://localhost:8000/auth/callback

# МЭШ API (если нужно)
MESH_API_URL=https://api.mos.ru